{
    "name": "rsgrinko/laravel-mailerservice-sdk",
    "description": "SDK сервиса отправки почты для Laravel: клиент API и почтовый транспорт",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mail", "mailer", "smtp", "queue", "mailerservice"],
    "authors": [
        {
            "name": "Роман Гринько",
            "email": "rsgrinko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
        "symfony/mime": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Rsgrinko\\MailServiceSdk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rsgrinko\\MailServiceSdk\\MailServiceProvider"
            ],
            "aliases": {
                "MailService": "Rsgrinko\\MailServiceSdk\\Facades\\MailService"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
